
# ============================================================
# Flow-LLMOps 环境变量模板
#
# 使用方法（首次部署必做）：
#   cd docker && cp .env.example .env
#   然后按需修改 .env 中的账号密码，再执行 docker compose up -d
#
# 注意：
#   .env 包含真实凭证，已被 .gitignore 排除，不会提交到仓库
#   生产环境务必修改所有默认账号密码（PostgreSQL/Redis/MinIO/ClickHouse/默认登录账号）
# ============================================================

# redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_AUTH=chenjun1234

# minio 配置
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=chenjun
MINIO_ROOT_PASSWORD=chenjun1234

# postgres配置
POSTGRES_HOST=localhost
POSTGRES_USER=chenjun
POSTGRES_PASSWORD=chenjun1234
POSTGRES_PORT=5432
POSTGRES_APP_DB=llmops

# clickhouse 配置 
CLICKHOUSE_HOST=localhost
CLICKHOUSE_USER=chenjun
CLICKHOUSE_PASSWORD=chenjun1234
CLICKHOUSE_PORT=8123
CLICKHOUSE_CONSOLE_PORT=19000

# langfuse 配置
## langfuse-worker
SALT=289b2a8f6181543a727b5f05561358c1
